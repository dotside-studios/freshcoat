{
	"format_version": "1.0",
	"version": "1.0.0",
	"id": "freshcoat-social-preview",
	"name": "Freshcoat social preview",
	"description": "The GitHub social preview for the Freshcoat repository, rendered with the freshcoat CLI.",
	"width": 1280,
	"height": 640,
	"fonts": [
		{
			"kind": "google",
			"family": "Inter",
			"url": "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap"
		}
	],
	"fields": {
		"type": "object",
		"properties": {
			"tagline": {
				"type": "string",
				"title": "Tagline",
				"default": "Create designs that scale."
			},
			"summary": {
				"type": "string",
				"title": "Summary",
				"default": "An open-source template format, Skia renderer and batch export for cards, badges, labels and certificates."
			},
			"repo": {
				"type": "string",
				"title": "Repository",
				"default": "github.com/dotside-studios/freshcoat"
			},
			"url": {
				"type": "string",
				"title": "QR link",
				"default": "https://github.com/dotside-studios/freshcoat"
			},
			"name": {
				"type": "string",
				"title": "Card name",
				"default": "Alex Rivera"
			},
			"role": {
				"type": "string",
				"title": "Card role",
				"default": "Template designer"
			}
		},
		"required": [
			"tagline",
			"summary",
			"repo",
			"url",
			"name",
			"role"
		]
	},
