{
	"name": "@freshcoat-js/editor",
	"private": true,
	"version": "0.0.0",
	"license": "Apache-2.0",
	"author": "Dotside Studios",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dotside-studios/freshcoat.git",
		"directory": "apps/editor"
	},
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 3010",
		"build": "vite build",
		"preview": "vite preview --port 3010",
		"test": "vitest run && bun test ./server.test.ts",
		"typecheck": "tsc --noEmit",
		"check": "biome check",
		"e2e": "playwright test",
		"e2e:smoke": "playwright test e2e/smoke.spec.ts e2e/workspace.spec.ts e2e/data.spec.ts e2e/export.spec.ts e2e/starters.spec.ts e2e/barcode.spec.ts e2e/sheets.spec.ts e2e/url.spec.ts e2e/handoff.spec.ts",
		"fonts:update": "bun scripts/update-google-fonts.ts",
		"notices": "bun ../../scripts/third-party-notices.ts",
		"notices:check": "bun ../../scripts/third-party-notices.ts --check",
		"boundaries": "bun ../../scripts/check-boundaries.ts",
		"test:scripts": "bun test ../../scripts",
		"bench:render": "bun scripts/bench-render.ts"
	},
	"dependencies": {
		"@freshcoat-js/coatfile": "workspace:*",
		"@freshcoat-js/engine": "workspace:*",
		"@freshcoat-js/for-print": "workspace:*",
		"@freshcoat-js/ui": "workspace:*",
		"@freshcoat-js/workspace": "workspace:*",
		"@tanstack/react-router": "1.170.33",
		"@tanstack/react-virtual": "^3.14.13",
		"canvaskit-wasm": "^0.41.1",
		"fflate": "^0.8.3",
		"immer": "^10.2.0",
		"pdf-lib": "^1.17.1",
		"react": "^19.2.0",
		"react-aria-components": "^1.19.0",
		"react-dom": "^19.2.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.5",
		"@freshcoat-js/test-utils": "workspace:*",
		"@iconify-json/mingcute": "^1.2.7",
		"@playwright/test": "^1.56.1",
		"@svgr/core": "^8.1.0",
		"@svgr/plugin-jsx": "^8.1.0",
		"@tailwindcss/vite": "^4.1.18",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/bun": "^1.3.12",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"fake-indexeddb": "^6.2.5",
		"jsdom": "^28.1.0",
		"tailwindcss": "^4.1.18",
		"typescript": "^5.7.2",
		"unplugin-icons": "^23.0.1",
		"vite": "^8.0.0",
		"vitest": "^3.0.5"
	}
}
