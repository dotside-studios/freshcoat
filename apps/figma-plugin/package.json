{
	"name": "@freshcoat/figma-plugin",
	"private": true,
	"version": "0.1.0",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dotside-studios/freshcoat.git",
		"directory": "apps/figma-plugin"
	},
	"type": "module",
	"figma-plugin": {
		"name": "Freshcoat for Figma",
		"id": "davi-card-importer",
		"main": "src/main/index.ts",
		"ui": "src/ui/index.tsx",
		"editorType": ["figma"],
		"networkAccess": {
			"allowedDomains": ["https://davishopusercontent.dotsidecdn.net"],
			"reasoning": "Only when you choose the \"Davi card product\" canvas: fetches the published product catalog (catalog/products.json) so the product list stays in sync with the order site. The default custom export makes no network requests."
		}
	},
	"scripts": {
		"build": "build-figma-plugin --typecheck --minify",
		"watch": "build-figma-plugin --typecheck --watch",
		"test": "vitest run",
		"check": "biome check",
		"typecheck": "tsc --noEmit && tsc --noEmit -p harness",
		"harness": "build-figma-plugin && bun harness/serve.ts",
		"harness:test": "build-figma-plugin && playwright test -c harness/playwright.config.ts"
	},
	"dependencies": {
		"@create-figma-plugin/ui": "^4.0.3",
		"@create-figma-plugin/utilities": "^4.0.3",
		"@freshcoat/coatfile": "workspace:*",
		"fflate": "^0.8.3",
		"freshcoat": "workspace:*",
		"js-sha256": "^0.11.0",
		"preact": "^10.29.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.5",
		"@create-figma-plugin/build": "^4.0.3",
		"@figma/plugin-typings": "^1.100.0",
		"@playwright/test": "^1.56.1",
		"typescript": "^5.7.2",
		"vitest": "^3.0.5"
	}
}
