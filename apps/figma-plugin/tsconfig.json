{
	"include": ["**/*.ts", "**/*.tsx"],
	"exclude": ["node_modules", "dist", "vitest.config.ts", "harness"],
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["@figma/plugin-typings"],
		"jsx": "react-jsx",
		"jsxImportSource": "preact",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"skipLibCheck": true,
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"paths": { "~/*": ["./src/*"] }
	}
}
