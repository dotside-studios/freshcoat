{
	"name": "freshcoat",
	"private": true,
	"version": "0.0.0",
	"license": "Apache-2.0",
	"type": "module",
	"packageManager": "bun@1.3.13",
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"jsdom": "^28.1.0",
			"vitest": "^4.1.6"
		}
	},
	"scripts": {
		"dev": "bun run --cwd apps/editor dev",
		"build": "bun run --cwd apps/editor build",
		"check": "biome check .",
		"format": "biome check --write .",
		"check:boundaries": "bun scripts/check-boundaries.ts",
		"check:links": "bun scripts/check-links.ts",
		"check:notices": "bun scripts/third-party-notices.ts --check",
		"test:scripts": "bun test ./scripts",
		"test": "bun run --filter '*' test",
		"typecheck": "bun run --filter '*' typecheck",
		"release:pack": "bun scripts/release-packages.ts",
		"release:check": "bun scripts/check-release-packages.ts",
		"release:figma": "bun scripts/bundle-figma-plugin.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.5",
		"github-slugger": "^2.0.0",
		"typescript": "^5.7.2"
	}
}
