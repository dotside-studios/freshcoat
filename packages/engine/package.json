{
	"name": "@freshcoat-js/engine",
	"private": true,
	"version": "0.3.0",
	"description": "A composable 2D scene renderer powered by CanvasKit and Skia",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dotside-studios/freshcoat.git",
		"directory": "packages/engine"
	},
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./browser": "./src/platform/browser.ts",
		"./image": "./src/image-info.ts",
		"./node": "./src/platform/node.ts",
		"./path": "./src/path-data.ts",
		"./pdf": "./src/pdf/index.ts",
		"./svg": "./src/svg/index.ts",
		"./svg/path": "./src/svg/path.ts",
		"./svg/sniff": "./src/svg/sniff.ts"
	},
	"scripts": {
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"conformance": "bun run conformance/src/report.ts --goldens",
		"conformance:regen": "bun run conformance/src/author-cases.ts && bun run conformance/src/generate-goldens.ts"
	},
	"dependencies": {
		"canvaskit-wasm": "0.41.1"
	},
	"devDependencies": {
		"@freshcoat-js/test-utils": "workspace:*",
		"@types/bun": "^1.3.12",
		"@types/node": "^26.6.3",
		"typescript": "^5.7.2",
		"vitest": "^4.1.6"
	}
}
