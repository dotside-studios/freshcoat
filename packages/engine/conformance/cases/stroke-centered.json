{
	"id": "stroke-centered",
	"title": "an unaligned stroke straddles the shape edge",
	"profile": "core",
	"requires": [
		"draw.stroke"
	],
	"width": 160,
	"height": 120,
	"scene": {
		"kind": "group",
		"children": [
			{
				"kind": "rect",
				"pos": {
					"x": 0,
					"y": 0
				},
				"size": {
					"width": 160,
					"height": 120
				},
				"fills": [
					{
						"kind": "solid",
						"color": "#ffffff"
					}
				]
			},
			{
				"kind": "rect",
				"pos": {
					"x": 40,
					"y": 30
				},
				"size": {
					"width": 80,
					"height": 60
				},
				"fills": [
					{
						"kind": "solid",
						"color": "#ffffff"
					}
				],
				"stroke": {
					"color": "#000000",
					"width": 8
				}
			}
		],
		"pos": {
			"x": 0,
			"y": 0
		},
		"size": {
			"width": 160,
			"height": 120
		}
	},
	"assertions": [
		{
			"kind": "pixel",
			"at": [
				40,
				60
			],
			"expect": [
				0,
				0,
				0,
				255
			],
			"why": "on the edge, inside the stroke"
		},
		{
			"kind": "pixel",
			"at": [
				80,
				60
			],
			"expect": [
				255,
				255,
				255,
				255
			],
			"why": "the interior"
		},
		{
			"kind": "pixel",
			"at": [
				30,
				60
			],
			"expect": [
				255,
				255,
				255,
				255
			],
			"why": "10px outside, past the stroke"
		}
	]
}
