{
	"id": "adjust-lut-keeps-shadow-color",
	"title": "a LUT adjusts the content and leaves the drop shadow's color",
	"profile": "raster",
	"requires": [
		"adjust.lut",
		"effect.shadow"
	],
	"width": 160,
	"height": 120,
	"scene": {
		"kind": "group",
		"children": [
			{
				"kind": "rect",
				"pos": {
					"x": 0,
					"y": 0
				},
				"size": {
					"width": 160,
					"height": 120
				},
				"fills": [
					{
						"kind": "solid",
						"color": "#ffffff"
					}
				]
			},
			{
				"kind": "rect",
				"pos": {
					"x": 20,
					"y": 40
				},
				"size": {
					"width": 40,
					"height": 40
				},
				"fills": [
					{
						"kind": "solid",
						"color": "#808080"
					}
				],
				"shadow": {
					"color": "#2040c0",
					"dx": 60,
					"dy": 0,
					"blur": 0
				},
				"adjust": {
					"lut": {
						"r": {
							"__u8": ""
						},
						"g": {
							"__u8": ""
						},
						"b": {
							"__u8": ""
						}
					}
				}
			}
		],
		"pos": {
			"x": 0,
			"y": 0
		},
		"size": {
			"width": 160,
			"height": 120
		}
	},
	"assertions": [
		{
			"kind": "pixel",
			"at": [
				40,
				60
			],
			"expect": [
				64,
				64,
				64,
				255
			],
			"why": "128 at gamma 2 is 64",
			"tolerance": 2
		},
		{
			"kind": "pixel",
			"at": [
				100,
				60
			],
			"expect": [
				32,
				64,
				192,
				255
			],
			"why": "the shadow in its own color",
			"tolerance": 2
		}
	]
}
