{
	"id": "stroke-sides-gradient",
	"title": "a per-side stroke paints its gradient across the box",
	"profile": "core",
	"requires": [
		"draw.stroke",
		"stroke.sides",
		"fill.linear"
	],
	"width": 160,
	"height": 120,
	"scene": {
		"kind": "group",
		"children": [
			{
				"kind": "rect",
				"pos": {
					"x": 0,
					"y": 0
				},
				"size": {
					"width": 160,
					"height": 120
				},
				"fills": [
					{
						"kind": "solid",
						"color": "#ffffff"
					}
				]
			},
			{
				"kind": "rect",
				"pos": {
					"x": 40,
					"y": 30
				},
				"size": {
					"width": 80,
					"height": 60
				},
				"fills": [
					{
						"kind": "solid",
						"color": "#ffffff"
					}
				],
				"stroke": {
					"color": "#ff0000",
					"gradient": {
						"kind": "linear",
						"from": {
							"x": 0,
							"y": 0.5
						},
						"to": {
							"x": 1,
							"y": 0.5
						},
						"stops": [
							{
								"offset": 0,
								"color": "#ff0000"
							},
							{
								"offset": 1,
								"color": "#0000ff"
							}
						]
					},
					"width": 10,
					"sides": {
						"top": 0,
						"right": 10,
						"bottom": 0,
						"left": 10
					},
					"align": "inside"
				}
			}
		],
		"pos": {
			"x": 0,
			"y": 0
		},
		"size": {
			"width": 160,
			"height": 120
		}
	},
	"assertions": [
		{
			"kind": "pixel",
			"at": [
				42,
				60
			],
			"expect": [
				247,
				0,
				8,
				255
			],
			"why": "the left band, near the red end",
			"tolerance": 12
		},
		{
			"kind": "pixel",
			"at": [
				117,
				60
			],
			"expect": [
				8,
				0,
				247,
				255
			],
			"why": "the right band, near the blue end",
			"tolerance": 12
		},
		{
			"kind": "pixel",
			"at": [
				80,
				32
			],
			"expect": [
				255,
				255,
				255,
				255
			],
			"why": "the top side, with no width"
		}
	]
}
