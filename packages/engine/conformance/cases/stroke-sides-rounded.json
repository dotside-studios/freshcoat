{
	"id": "stroke-sides-rounded",
	"title": "a per-side stroke's inner corner shrinks by each adjacent width",
	"profile": "core",
	"requires": [
		"draw.stroke",
		"stroke.sides",
		"shape.cornerRadius"
	],
	"width": 160,
	"height": 120,
	"scene": {
		"kind": "group",
		"children": [
			{
				"kind": "rect",
				"pos": {
					"x": 0,
					"y": 0
				},
				"size": {
					"width": 160,
					"height": 120
				},
				"fills": [
					{
						"kind": "solid",
						"color": "#ffffff"
					}
				]
			},
			{
				"kind": "rect",
				"pos": {
					"x": 40,
					"y": 30
				},
				"size": {
					"width": 80,
					"height": 60
				},
				"fills": [
					{
						"kind": "solid",
						"color": "#ffffff"
					}
				],
				"cornerRadius": 20,
				"stroke": {
					"color": "#000000",
					"width": 16,
					"sides": {
						"top": 2,
						"right": 2,
						"bottom": 16,
						"left": 2
					},
					"align": "inside"
				}
			}
		],
		"pos": {
			"x": 0,
			"y": 0
		},
		"size": {
			"width": 160,
			"height": 120
		}
	},
	"assertions": [
		{
			"kind": "pixel",
			"at": [
				80,
				82
			],
			"expect": [
				0,
				0,
				0,
				255
			],
			"why": "the 16px bottom band"
		},
		{
			"kind": "pixel",
			"at": [
				80,
				72
			],
			"expect": [
				255,
				255,
				255,
				255
			],
			"why": "above the bottom band"
		},
		{
			"kind": "pixel",
			"at": [
				55,
				72
			],
			"expect": [
				255,
				255,
				255,
				255
			],
			"why": "inside the flat inner corner"
		},
		{
			"kind": "pixel",
			"at": [
				42,
				31
			],
			"expect": [
				255,
				255,
				255,
				255
			],
			"why": "outside the rounded outer corner"
		}
	]
}
