{
	"id": "supersample",
	"title": "supersampling changes samples, not output geometry",
	"profile": "raster",
	"requires": [
		"export.supersample"
	],
	"width": 160,
	"height": 120,
	"compile": {
		"supersample": 2
	},
	"scene": {
		"kind": "group",
		"children": [
			{
				"kind": "rect",
				"pos": {
					"x": 0,
					"y": 0
				},
				"size": {
					"width": 160,
					"height": 120
				},
				"fills": [
					{
						"kind": "solid",
						"color": "#ffffff"
					}
				]
			},
			{
				"kind": "rect",
				"pos": {
					"x": 40,
					"y": 30
				},
				"size": {
					"width": 80,
					"height": 60
				},
				"fills": [
					{
						"kind": "solid",
						"color": "#2f6fed"
					}
				]
			}
		],
		"pos": {
			"x": 0,
			"y": 0
		},
		"size": {
			"width": 160,
			"height": 120
		}
	},
	"assertions": [
		{
			"kind": "pixel",
			"at": [
				80,
				60
			],
			"expect": [
				47,
				111,
				237,
				255
			],
			"why": "the centre, at the design-space coordinate"
		},
		{
			"kind": "pixel",
			"at": [
				10,
				10
			],
			"expect": [
				255,
				255,
				255,
				255
			],
			"why": "outside the rect"
		}
	]
}
