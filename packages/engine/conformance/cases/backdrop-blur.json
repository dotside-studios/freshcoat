{
	"id": "backdrop-blur",
	"title": "backdrop blur blurs what lies beneath the shape, with the layer blur's sigma",
	"profile": "core",
	"requires": [
		"effect.backdropBlur"
	],
	"width": 160,
	"height": 120,
	"scene": {
		"kind": "group",
		"children": [
			{
				"kind": "rect",
				"pos": {
					"x": 0,
					"y": 0
				},
				"size": {
					"width": 160,
					"height": 120
				},
				"fills": [
					{
						"kind": "solid",
						"color": "#ffffff"
					}
				]
			},
			{
				"kind": "rect",
				"pos": {
					"x": 0,
					"y": 0
				},
				"size": {
					"width": 80,
					"height": 120
				},
				"fills": [
					{
						"kind": "solid",
						"color": "#000000"
					}
				]
			},
			{
				"kind": "rect",
				"pos": {
					"x": 40,
					"y": 20
				},
				"size": {
					"width": 80,
					"height": 80
				},
				"backdropBlur": 20
			}
		],
		"pos": {
			"x": 0,
			"y": 0
		},
		"size": {
			"width": 160,
			"height": 120
		}
	},
	"assertions": [
		{
			"kind": "pixel",
			"at": [
				80,
				60
			],
			"expect": [
				128,
				128,
				128,
				255
			],
			"why": "half intensity at the edge",
			"tolerance": 22
		},
		{
			"kind": "pixel",
			"at": [
				89,
				60
			],
			"expect": [
				216,
				216,
				216,
				255
			],
			"why": "one sigma (8.8px) inside the white: ~85% white",
			"tolerance": 20
		},
		{
			"kind": "pixel",
			"at": [
				78,
				10
			],
			"expect": [
				0,
				0,
				0,
				255
			],
			"why": "above the shape the edge stays sharp"
		},
		{
			"kind": "pixel",
			"at": [
				82,
				10
			],
			"expect": [
				255,
				255,
				255,
				255
			],
			"why": "above the shape the edge stays sharp"
		}
	]
}
