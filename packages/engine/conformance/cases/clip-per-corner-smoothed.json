				255,
				255
			],
			"why": "a circular arc fills here",
			"tolerance": 40
		},
		{
			"kind": "pixel",
			"at": [
				20,
				38
			],
			"expect": [
				255,
				255,
				255,
				255
			],
			"why": "a circular arc fills here",
			"tolerance": 40
		},
		{
			"kind": "pixel",
			"at": [
				138,
				12
			],
			"expect": [
				0,
				0,
				0,
				255
			],
			"why": "the square top-right corner"
		},
		{
			"kind": "pixel",
			"at": [
				80,
				60
			],
			"expect": [
				0,
				0,
				0,
				255
			],
			"why": "the interior"
		}
