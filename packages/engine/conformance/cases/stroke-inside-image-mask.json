{
	"id": "stroke-inside-image-mask",
	"title": "an inside-aligned stroke on a masked image follows the mask inward",
	"profile": "core",
	"requires": [
		"draw.image",
		"draw.stroke",
		"stroke.align"
	],
	"width": 160,
	"height": 120,
	"scene": {
		"kind": "group",
		"children": [
			{
				"kind": "rect",
				"pos": {
					"x": 0,
					"y": 0
				},
				"size": {
					"width": 160,
					"height": 120
				},
				"fills": [
					{
						"kind": "solid",
						"color": "#ffffff"
					}
				]
			},
			{
				"kind": "image",
				"pos": {
					"x": 40,
					"y": 20
				},
				"size": {
					"width": 80,
					"height": 80
				},
				"src": "conformance:checker",
				"fit": "cover",
				"mask": {
					"kind": "circle"
				},
				"stroke": {
					"color": "#000000",
					"width": 8,
					"align": "inside"
				}
			}
		],
		"pos": {
			"x": 0,
			"y": 0
		},
		"size": {
			"width": 160,
			"height": 120
		}
	},
	"assertions": [
		{
			"kind": "pixel",
			"at": [
				44,
				60
			],
			"expect": [
				0,
				0,
				0,
				255
			],
			"why": "inside the circle's left edge"
		},
		{
			"kind": "pixel",
			"at": [
				36,
				60
			],
			"expect": [
				255,
				255,
				255,
				255
			],
			"why": "outside the circle's left edge"
		}
	]
}
