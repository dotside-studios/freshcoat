{
	"id": "rotation-rotates-the-shadow",
	"title": "a rotated element's shadow offset rotates with it",
	"profile": "core",
	"requires": [
		"transform.rotation",
		"effect.shadow"
	],
	"width": 160,
	"height": 120,
	"scene": {
		"kind": "group",
		"children": [
			{
				"kind": "rect",
				"pos": {
					"x": 0,
					"y": 0
				},
				"size": {
					"width": 160,
					"height": 120
				},
				"fills": [
					{
						"kind": "solid",
						"color": "#ffffff"
					}
				]
			},
			{
				"kind": "rect",
				"pos": {
					"x": 55,
					"y": 35
				},
				"size": {
					"width": 50,
					"height": 50
				},
				"fills": [
					{
						"kind": "solid",
						"color": "#2f6fed"
					}
				],
				"rotation": 90,
				"shadow": {
					"color": "#000000",
					"dx": 0,
					"dy": 14,
					"blur": 0
				}
			}
		],
		"pos": {
			"x": 0,
			"y": 0
		},
		"size": {
			"width": 160,
			"height": 120
		}
	},
	"assertions": [
		{
			"kind": "pixel",
			"at": [
				48,
				60
			],
			"expect": [
				0,
				0,
				0,
				255
			],
			"why": "the shadow landed LEFT of the element, rotated with it"
		},
		{
			"kind": "pixel",
			"at": [
				80,
				60
			],
			"expect": [
				47,
				111,
				237,
				255
			],
			"why": "the element itself, over its own shadow"
		},
		{
			"kind": "pixel",
			"at": [
				80,
				92
			],
			"expect": [
				255,
				255,
				255,
				255
			],
			"why": "nothing below it: an UNROTATED shadow would be here"
		}
	]
}
