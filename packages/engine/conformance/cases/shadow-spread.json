{
	"id": "shadow-spread",
	"title": "spread grows the silhouette the shadow is cast from",
	"profile": "core",
	"requires": [
		"effect.shadow",
		"shadow.spread"
	],
	"width": 160,
	"height": 120,
	"scene": {
		"kind": "group",
		"children": [
			{
				"kind": "rect",
				"pos": {
					"x": 0,
					"y": 0
				},
				"size": {
					"width": 160,
					"height": 120
				},
				"fills": [
					{
						"kind": "solid",
						"color": "#ffffff"
					}
				]
			},
			{
				"kind": "rect",
				"pos": {
					"x": 60,
					"y": 40
				},
				"size": {
					"width": 40,
					"height": 40
				},
				"fills": [
					{
						"kind": "solid",
						"color": "#2f6fed"
					}
				],
				"shadow": {
					"color": "#000000",
					"dx": 0,
					"dy": 0,
					"blur": 0,
					"spread": 10
				}
			}
		],
		"pos": {
			"x": 0,
			"y": 0
		},
		"size": {
			"width": 160,
			"height": 120
		}
	},
	"assertions": [
		{
			"kind": "pixel",
			"at": [
				55,
				60
			],
			"expect": [
				0,
				0,
				0,
				255
			],
			"why": "5px outside the shape, inside the 10px spread"
		},
		{
			"kind": "pixel",
			"at": [
				45,
				60
			],
			"expect": [
				255,
				255,
				255,
				255
			],
			"why": "15px outside, past the spread"
		},
		{
			"kind": "pixel",
			"at": [
				80,
				60
			],
			"expect": [
				47,
				111,
				237,
				255
			],
			"why": "the shape itself"
		}
	]
}
