{
	"name": "@freshcoat-js/coatfile",
	"private": true,
	"version": "0.3.0",
	"description": "The Freshcoat template format, validator and compiler for data-driven designs",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dotside-studios/freshcoat.git",
		"directory": "packages/coatfile"
	},
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./assets": "./src/assets.ts",
		"./barcode": "./src/barcode.ts",
		"./barcode-encoder": "./src/barcode-encoder.ts",
		"./bleed": "./src/bleed.ts",
		"./render": "./src/render.ts",
		"./svg": "./src/svg.ts",
		"./normalize": "./src/normalize.ts",
		"./coat": "./src/coat.ts",
		"./fixtures": "./fixtures/index.ts",
		"./schema/*": "./schema/*"
	},
	"scripts": {
		"test": "bun test",
		"schema": "bun run scripts/build-json-schema.ts",
		"schema:check": "bun run scripts/build-json-schema.ts --check",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@freshcoat-js/engine": "workspace:*",
		"@freshcoat-js/for-print": "workspace:*",
		"bwip-js": "^4.11.4",
		"fflate": "^0.8.3",
		"lean-qr": "^2.7.4",
		"zod": "^4.1.13"
	},
	"devDependencies": {
		"@freshcoat-js/test-utils": "workspace:*",
		"@types/bun": "^1.3.12",
		"@zxing/library": "^0.23.0",
		"typescript": "^5.7.2",
		"vitest": "^4.1.6"
	}
}
